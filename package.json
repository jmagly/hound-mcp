{
  "name": "@jmagly/codehound-mcp",
  "version": "0.3.0",
  "description": "MCP server for multi-modal code search: text (Hound), symbols (tree-sitter), and future semantic search",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "codehound-mcp": "dist/index.js",
    "codehound-auth": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hound",
    "code-search",
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "gitea",
    "github"
  ],
  "author": "jmagly",
  "license": "MIT",
  "homepage": "https://github.com/jmagly/mcp-hound#readme",
  "bugs": {
    "url": "https://github.com/jmagly/mcp-hound/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmagly/mcp-hound.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "web-tree-sitter": "^0.26.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
